      "replacement_bytes": 65,
      "replacement_sha256": "26686E25CB14925FBF87F39F6C19C63C42EB7894B17E3E097F6BDDCF3FC3E352",
      "replacement_text": "$K \\otimes_k \\Omega_{k/\\mathbf{F}_p} \\to \\Omega_{K/\\mathbf{F}_p}$",
      "source_end_line": 44324,
      "source_start_line": 44324,
      "start_byte": 1634644
