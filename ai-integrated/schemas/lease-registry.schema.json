{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KokunoYumeto/mathematics-commons-stacks/raw/main/schemas/lease-registry.schema.json",
  "title": "Mathematics Commons Stacks candidate-namespace lease registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "upstream_lock", "namespace_root", "events"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "mathematics-commons-stacks-lease-registry/v1"},
    "upstream_lock": {"const": "upstream/stacks.lock.json"},
    "namespace_root": {"const": "commons/stacks"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "event", "lease_id", "namespace", "candidate_path", "writer_task", "upstream_commit", "upstream_tree", "issued_at_utc", "state", "writer_contract"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^lease-event-[0-9]{6}$"},
          "event": {"enum": ["issued", "released", "superseded"]},
          "lease_id": {"type": "string", "pattern": "^stacks-lease-[0-9]{6}-[a-z0-9-]+$"},
          "namespace": {"type": "string", "pattern": "^commons/stacks/[a-z0-9][a-z0-9/-]*$"},
          "candidate_path": {"type": "string", "pattern": "^candidates/commons/stacks/[a-z0-9][a-z0-9/-]*$"},
          "writer_task": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
          "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "upstream_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "issued_at_utc": {"type": "string", "format": "date-time"},
          "state": {"enum": ["active", "released", "superseded"]},
          "supersedes_event_id": {"type": "string"},
          "writer_contract": {"const": "candidates/CONTRACT.md"}
        }
      }
    }
  }
}
