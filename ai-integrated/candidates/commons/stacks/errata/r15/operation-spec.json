      "old_sha256": "66BB922F1DFEFE805CDE6321B76E83557E41228EBE9FB765DE841E859A4D0A9C",
      "old_text": "We say $A$ is {\\it simple} if the only two-sided ideals of $A$ are\n$0$ and $A$.",
      "operation_index": 1,
      "producer_id": "BRAUER-003",
      "replacement_bytes": 97,
      "replacement_sha256": "093C78DFF3D5EB80DC5927F4727D831276CBCDE5A304507466FF16ACCAD0D3B1",
      "replacement_text": "We say $A$ is {\\it simple} if it is nonzero and the only two-sided\nideals of $A$ are $0$ and $A$.",
      "source_end_line": 64,
      "source_start_line": 63,
      "stable_id": "MC-STK-ERR-0746",
      "start_byte": 1838
    },
