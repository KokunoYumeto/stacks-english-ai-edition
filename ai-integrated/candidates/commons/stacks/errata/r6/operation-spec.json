      "old_sha256": "A71AE5FF8319E21BC236F811CA49A50D2E09978FDFD02AC1A1780628CAF41D09",
      "old_text": "Let $I \\subset R$ be an ideal.",
      "operation_index": 1,
      "producer_id": "ALGEBRA-291",
      "replacement_bytes": 81,
      "replacement_sha256": "FAAFDFBCB0D4E52B349744F72654297BD3DC0556F1451EF9A073F25C2620FFFA",
      "replacement_text": "The unit ideal is the empty product. Let $I \\subset R$ be a nonzero proper ideal.",
