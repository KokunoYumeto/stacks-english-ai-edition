      "occurrence_count_in_frozen_authority": 4,
      "old_bytes": 12,
      "old_sha256": "C251EB3C559F00EA3A178FB90DE2516DD79F95F76DC9863A1CF0DDA221864C11",
      "old_text": "We can write",
      "operation_index": 1,
