{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KokunoYumeto/stacks-project/stacks-ega-prelease-overlay-export/v1",
  "title": "Stacks-EGA pre-lease overlay export proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "namespace",
    "lifecycle_state",
    "created_at_utc",
    "producer",
    "upstream",
    "source_branch",
    "payload",
    "provenance",
    "stable_ids",
    "rights",
    "review",
    "replay",
    "dependencies",
    "conflicts",
    "supersedes",
    "package_files",
    "notes"
  ],
  "properties": {
    "schema": {"const": "stacks-ega-prelease-overlay-export/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "kind": {"const": "stacks_source_overlay_prelease_export"},
    "namespace": {"type": "string", "pattern": "^commons/stacks/[a-z0-9][a-z0-9._/-]*$"},
    "lifecycle_state": {"const": "prelease_export_prepared"},
    "created_at_utc": {"type": "string"},
    "producer": {"type": "object"},
    "upstream": {"type": "object"},
    "source_branch": {"type": "object"},
    "payload": {"type": "object"},
    "provenance": {"type": "object"},
    "stable_ids": {"type": "object"},
    "rights": {"type": "object"},
    "review": {"type": "object"},
    "replay": {"type": "object"},
    "dependencies": {"type": "array"},
    "conflicts": {"type": "array"},
    "supersedes": {"type": "array"},
    "package_files": {"type": "array"},
    "notes": {"type": "array"}
  }
}
